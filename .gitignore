# ── Survey microdata (restricted / licensed) ──────────────────────────────────
# National household surveys — not for redistribution
*.dta
*.sav
*.RData
# IPUMS raw data extracts
*.dat
# EPA Spain raw fixed-width microdata files
bases\ armo/raw/esp/**/*.txt
bases\ armo/raw/esp/ficheros/
bases\ armo/raw/esp/2*/

# Compressed raw data
*.zip
*.gz
*.tar
*.7z

# Survey dictionary files (ODS format)
*.ODS
*.ods

# ── Output folder (all generated — regenerate with analysis scripts) ───────────
# Covers both the main HDMF pipeline outputs (out/indicator_descriptive/, out/trends/, etc.)
# AND the Remittances Spillover sub-project outputs (out/remittances/data/, out/remittances/figures/).
# Large derived CSVs (HND_all_waves.csv ~430 MB, HND_panel_geo_year.csv) are never committed.
# Regenerate with: py "bases armo/armo/hnd_databases.py"
out/

# ── Intermediate output files ──────────────────────────────────────────────────
bases\ armo/armo/out_indicators/

# ── Raw data documentation (PDFs, merged CSVs — tied to licensed data) ────────
bases\ armo/raw/**/*.pdf
bases\ armo/raw/**/*.csv

# ── Stata artefacts ────────────────────────────────────────────────────────────
*.stswp
*.stsw
*.smcl
*.ster
# Log files (auto-generated per run)
do armo/*/logs/
*.log

# Run artifact captures (stderr/stdout redirected to files)
*.err
*.out
*_coverage_*.txt
hdmf_build_*.txt
bases\ armo/armo/*.txt
bases\ armo/armo/*.log
bases\ armo/armo/*.err

# Python cache (regenerate with hdmf_build.py)
*.pkl

# LaTeX build artifacts
*.aux
*.toc
*.snm
*.nav
*.fls
*.fdb_latexmk

# Keep example synthetic data
!data/synthetic/*.dta

# ── Python artefacts ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.env
.venv/
*.egg-info/

# ── Office / binary outputs ────────────────────────────────────────────────────
*.xlsx
*.pptx
*.docx

# Draft/recovery scripts (keep locally, hide from public)
do\ armo/*/not_clean/

# Keep lookup tables that are not microdata
!bases\ armo/raw/col/ciuo_cod.xlsx
!bases\ armo/raw/col/code_pais.csv
!bases\ armo/raw/*/dr_EPA_2021.xlsx
!bases\ armo/raw/codigos_formacion.xlsx

# ── Internal workflow artifacts (not for public repo) ─────────────────────────
scratch/
session_journals/
plans/
backup\ files/
bases\ armo/intermediate_data/

# ── IDE / OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp
*~

# Personal documents (not project files)
analisis_claudecode_cv.pdf
